#!/bin/bash
#BSUB -n 16
#BSUB -W 60
#BSUB -R "rusage[mem=4]"
#BSUB -R "select[model==Gold6130]"
#BSUB -R "span[hosts=1]"
#BSUB -x
#BSUB -o row.txt
#BSUB -J ocean_row

OCEAN=./ocean_row
GRID=./grid1026_hotTop.txt
SIZE=1026
STEPS=5000

whoami
lscpu

for T in 1 2 4 8 16
do
    export OMP_NUM_THREADS=$T
    echo "=============================="
    echo "THREADS = $T"
    echo "=============================="
    for i in $(seq 1 10)
    do
        $OCEAN $SIZE $STEPS $GRID /dev/null
    done
done
